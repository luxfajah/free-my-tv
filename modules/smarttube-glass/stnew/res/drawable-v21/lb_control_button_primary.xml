<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:constantSize="true">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#66FFFFFF"
                android:centerColor="#44FFFFFF"
                android:endColor="#33FFFFFF"
                android:type="linear" />
            <stroke android:width="1.5dp" android:color="#D9FFFFFF" />
            <size android:width="@dimen/lb_control_button_diameter" android:height="@dimen/lb_control_button_diameter" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#22FFFFFF" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
            <size android:width="@dimen/lb_control_button_diameter" android:height="@dimen/lb_control_button_diameter" />
        </shape>
    </item>
</selector>
